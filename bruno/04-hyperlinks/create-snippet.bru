meta {
  name: Create snippet - as admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/snippets/
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "title": "Hello",
    "code": "print('hello')"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("snippetId", res.body.id);
  }
}
