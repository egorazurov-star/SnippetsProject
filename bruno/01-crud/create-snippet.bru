meta {
  name: Create snippet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/snippets/
  body: json
  auth: none
}

body:json {
  {
    "title": "Hello",
    "code": "print('hello')"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("snippetId", res.body.id);
  }
}
